{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2024"
  },
  "include": [
    "netlify/functions/**/*.mts",
    "types/**/*.d.ts"
  ]
}
